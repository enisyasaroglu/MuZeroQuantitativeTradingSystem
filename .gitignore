# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# Data (regenerated by src/pipeline/, not committed)
data/raw/
data/processed/

# Model checkpoints (regenerated by main_muzero.py / main_ppo.py).
# Binary training artifacts don't belong in git history -- they bloat
# clone size and every re-training run creates a new set. If you want a
# specific checkpoint available to reviewers, upload it as a GitHub
# Release asset instead, or use Git LFS.
src/models/*.pth
logs/checkpoints/
logs/tensorboard/

# Evaluation outputs (regenerated by evaluate.py)
logs/evaluation/*.csv
logs/evaluation/*.png
logs/evaluation/*.json

# OS
.DS_Store

# Environments
.env
.venv